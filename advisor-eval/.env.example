# Copy to .env (gitignored) in this folder.

# OpenAI API: needed for conditions that use a GPT executor or advisor
# (not needed for the Qwen / gpt-oss pairs served with vLLM)
OPENAI_API_KEY=sk-...

# Spend cap per scripts/run_experiment_plan.py session and per run_condition.py batch (USD)
MAX_TOTAL_USD=150

# Optional: override the vLLM endpoints from config.yaml (local_models.*.base_url)
# QWEN_EXECUTOR_URL=http://localhost:8001/v1
# QWEN_ADVISOR_URL=http://localhost:8002/v1
# OSS_EXECUTOR_URL=http://localhost:8003/v1
# OSS_ADVISOR_URL=http://localhost:8004/v1
# VLLM_API_KEY=EMPTY
